/* 收藏页面样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 顶部导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 20rpx;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.3s ease;
}

.nav-back:hover {
  background-color: #f0f0f0;
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  text-align: center;
}

.nav-right {
  width: 60rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
  padding: 0 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  color: #ff4757;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
  background-color: #2c3e50;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.empty-btn:hover {
  background-color: #34495e;
  transform: scale(1.05);
}

/* 收藏列表 */
.collection-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.collection-item {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.collection-item:hover {
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
  transform: translateY(-2rpx);
}

.collection-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-info {
  flex: 1;
  margin-right: 20rpx;
}

.collection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.collection-meta {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.collection-type {
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
  background-color: #e3f2fd;
  color: #2196f3;
  font-size: 20rpx;
  font-weight: bold;
}

.collection-time {
  font-size: 20rpx;
  color: #999;
}

.collection-action {
  flex-shrink: 0;
}

.cancel-collection {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  color: #666;
  font-size: 22rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.cancel-collection:hover {
  background-color: #e0e0e0;
  color: #ff4757;
}

/* 动画效果 */
.collection-item {
  animation: slideUp 0.5s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.collection-item:nth-child(1) {
  animation-delay: 0.1s;
}

.collection-item:nth-child(2) {
  animation-delay: 0.2s;
}

.collection-item:nth-child(3) {
  animation-delay: 0.3s;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .collection-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .collection-image {
    width: 100%;
    height: 200rpx;
    margin-right: 0;
    margin-bottom: 15rpx;
  }
  
  .collection-info {
    margin-right: 0;
    margin-bottom: 15rpx;
    width: 100%;
  }
  
  .collection-action {
    align-self: flex-end;
  }
}
