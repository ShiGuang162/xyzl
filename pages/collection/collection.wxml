<!-- 收藏页面 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="navigateBack">
      <view class="back-icon">←</view>
    </view>
    <view class="nav-title">我的收藏</view>
    <view class="nav-right"></view>
  </view>
  
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>
  
  <!-- 空状态 -->
  <view wx:elif="{{collections.length === 0 && !loading}}" class="empty-container">
    <view class="empty-icon">❤️</view>
    <view class="empty-text">暂无收藏内容</view>
    <view class="empty-hint">浏览景点和攻略时，点击收藏按钮添加到收藏列表</view>
    <view class="empty-btn" bindtap="navigateBack">去浏览</view>
  </view>
  
  <!-- 收藏列表 -->
  <view wx:else class="collection-list">
    <view wx:for="{{collections}}" wx:key="id" class="collection-item" bindtap="clickCollection" data-item="{{item}}">
      <view class="collection-image">
        <image src="{{item.image}}" class="item-image" />
      </view>
      <view class="collection-info">
        <view class="collection-title">{{item.title}}</view>
        <view class="collection-meta">
          <view class="collection-type">{{item.type === 'scenic' ? '景点' : '攻略'}}</view>
          <view class="collection-time">收藏于 {{item.collectTime}}</view>
        </view>
      </view>
      <view class="collection-action">
        <view class="cancel-collection" bindtap="cancelCollection" data-id="{{item.id}}">取消收藏</view>
      </view>
    </view>
  </view>
</view>