/* 产品列表页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 30rpx;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
  color: #666;
}

.input {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
  color: #333;
}

.input::placeholder {
  color: #999;
}

/* 分类滚动 */
.category-scroll {
  background-color: white;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 100rpx;
  z-index: 90;
}

.category-list {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx 20rpx;
  border-radius: 20rpx;
  background-color: #f8f8f8;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-color: #667eea;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  font-weight: 500;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background-color: white;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 200rpx;
  z-index: 80;
}

.sort-item {
  flex: 1;
  text-align: center;
  padding: 10rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.sort-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 产品列表 */
.product-list {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.product-item {
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.product-item:active {
  transform: scale(0.98);
}

.product-image {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.product-image image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.product-item:hover .product-image image {
  transform: scale(1.1);
}

.product-badge {
  position: absolute;
  top: 10rpx;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: white;
}

.product-badge.hot {
  left: 10rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
}

.product-badge.new {
  right: 10rpx;
  background: linear-gradient(135deg, #4ecdc4 0%, #45b7d1 100%);
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.product-description {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 15rpx;
}

.product-stats {
  display: flex;
  gap: 15rpx;
  font-size: 20rpx;
  color: #999;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.stat-icon {
  font-size: 20rpx;
}

/* 加载提示 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  color: #666;
}

.loading-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 24rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 无更多数据 */
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 响应式 */
@media (max-width: 375px) {
  .product-list {
    grid-template-columns: 1fr;
  }
  
  .product-image {
    height: 400rpx;
  }
}
