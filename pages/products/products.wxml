<!-- 产品列表页面 -->
<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <view class="search-icon">🔍</view>
      <input 
        type="text" 
        placeholder="搜索文创产品" 
        bindinput="searchProducts"
        class="input"
      />
    </view>
  </view>

  <!-- 分类选择 -->
  <scroll-view scroll-x="true" class="category-scroll">
    <view class="category-list">
      <view 
        class="category-item {{activeCategory === '' ? 'active' : ''}}" 
        bindtap="switchCategory"
        data-category=""
      >
        <view class="category-icon">🏠</view>
        <view class="category-name">全部</view>
      </view>
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="category-item {{activeCategory === item.name ? 'active' : ''}}"
        bindtap="switchCategory"
        data-category="{{item.name}}"
      >
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 排序选项 -->
  <view class="sort-bar">
    <view 
      class="sort-item {{sortBy === 'created_at' ? 'active' : ''}}" 
      bindtap="switchSort"
      data-sort="created_at"
    >
      最新
    </view>
    <view 
      class="sort-item {{sortBy === 'sales' ? 'active' : ''}}" 
      bindtap="switchSort"
      data-sort="sales"
    >
      销量
    </view>
    <view 
      class="sort-item {{sortBy === 'price' ? 'active' : ''}}" 
      bindtap="switchSort"
      data-sort="price"
    >
      价格
    </view>
    <view 
      class="sort-item {{sortBy === 'rating' ? 'active' : ''}}" 
      bindtap="switchSort"
      data-sort="rating"
    >
      评分
    </view>
  </view>

  <!-- 产品列表 -->
  <view class="product-list">
    <view 
      wx:for="{{products}}" 
      wx:key="id"
      class="product-item"
      bindtap="navigateToProductDetail"
      data-id="{{id}}"
    >
      <view class="product-image">
        <image src="{{image}}" mode="aspectFill"></image>
        <view wx:if="{{is_hot}}" class="product-badge hot">热门</view>
        <view wx:if="{{is_new}}" class="product-badge new">新品</view>
      </view>
      <view class="product-info">
        <view class="product-name">{{name}}</view>
        <view class="product-description">{{description}}</view>
        <view class="product-price">¥{{price}}</view>
        <view class="product-stats">
          <view class="stat-item">
            <view class="stat-icon">📊</view>
            <view class="stat-text">{{sales}} 销量</view>
          </view>
          <view class="stat-item">
            <view class="stat-icon">⭐</view>
            <view class="stat-text">{{rating}}分</view>
          </view>
          <view class="stat-item">
            <view class="stat-icon">💬</view>
            <view class="stat-text">{{review_count}}评价</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-icon">⏳</view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 无更多数据 -->
  <view wx:if="{{!loading && !hasMore && products.length > 0}}" class="no-more">
    没有更多产品了
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && products.length === 0}}" class="empty">
    <view class="empty-icon">📦</view>
    <view class="empty-text">暂无产品</view>
  </view>
</view>
