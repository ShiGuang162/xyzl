/* 修改密码页面样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #2c3e50;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-back:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 30rpx;
  font-weight: bold;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

/* 主内容区域 */
.content-area {
  padding: 120rpx 30rpx 30rpx;
}

/* 表单区域 */
.form-section {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item:hover {
  background-color: #f9f9f9;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  width: 140rpx;
}

.form-input {
  flex: 1;
  padding-left: 30rpx;
}

.form-input input {
  font-size: 26rpx;
  color: #333;
  width: 100%;
}

/* 密码强度提示 */
.password-strength {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.strength-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.strength-bars {
  height: 10rpx;
  background-color: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.strength-bar {
  height: 100%;
  border-radius: 5rpx;
  transition: all 0.3s ease;
}

.strength-text {
  font-size: 22rpx;
  color: #666;
  text-align: right;
}

/* 提交按钮区域 */
.submit-section {
  margin-top: 40rpx;
}

.submit-btn {
  background-color: #2196f3;
  color: white;
  border-radius: 10rpx;
  padding: 25rpx;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 10rpx rgba(33, 150, 243, 0.2);
}

.submit-btn:hover {
  background-color: #1976d2;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 15rpx rgba(33, 150, 243, 0.3);
}

.submit-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: 15rpx 20rpx;
  }
  
  .content-area {
    padding: 100rpx 20rpx 20rpx;
  }
  
  .form-item {
    padding: 20rpx 25rpx;
  }
  
  .form-label {
    width: 120rpx;
  }
}