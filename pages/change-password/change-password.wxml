<!-- 修改密码页面 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-left">
      <view class="nav-back" bindtap="navigateBack">
        <view class="back-icon">←</view>
      </view>
    </view>
    <view class="nav-center">
      <view class="nav-title">修改密码</view>
    </view>
    <view class="nav-right">
    </view>
  </view>
  
  <!-- 主内容区域 -->
  <view class="content-area">
    <!-- 修改密码表单 -->
    <view class="form-section">
      <view class="form-item">
        <view class="form-label">当前密码</view>
        <view class="form-input">
          <input value="{{currentPassword}}" bindinput="onCurrentPasswordChange" placeholder="请输入当前密码" password="{{true}}" />
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">新密码</view>
        <view class="form-input">
          <input value="{{newPassword}}" bindinput="onNewPasswordChange" placeholder="请输入新密码" password="{{true}}" />
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">确认新密码</view>
        <view class="form-input">
          <input value="{{confirmPassword}}" bindinput="onConfirmPasswordChange" placeholder="请确认新密码" password="{{true}}" />
        </view>
      </view>
    </view>
    
    <!-- 密码强度提示 -->
    <view class="password-strength" wx:if="{{newPassword}}">
      <view class="strength-label">密码强度</view>
      <view class="strength-bars">
        <view class="strength-bar" style="width: {{passwordStrength.width}}; background-color: {{passwordStrength.color}};"></view>
      </view>
      <view class="strength-text">{{passwordStrength.text}}</view>
    </view>
    
    <!-- 提交按钮 -->
    <view class="submit-section">
      <view class="submit-btn" bindtap="submitChangePassword">
        <view class="submit-text">确认修改</view>
      </view>
    </view>
  </view>
</view>