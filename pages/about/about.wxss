/* 关于我们页面 - Glassmorphism现代风格 */
page {
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
}

/* 顶部导航栏 - Glassmorphism风格 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 50%, #A78BFA 100%);
  color: white;
  box-shadow: 0 10rpx 40rpx rgba(124, 58, 237, 0.3);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  border-radius: 0 0 30rpx 30rpx;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.nav-right {
  width: 80rpx;
}

/* 主内容区域 */
.content-area {
  padding: 140rpx 30rpx 60rpx;
}

/* Logo区域 - Glassmorphism卡片 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logo-container {
  width: 180rpx;
  height: 180rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 50%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 35rpx;
  box-shadow: 0 12rpx 40rpx rgba(124, 58, 237, 0.3), 0 0 60rpx rgba(124, 58, 237, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  animation: logoFloat 3s ease-in-out infinite, logoGlow 2s ease-in-out infinite;
}

@keyframes logoFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes logoGlow {
  0%, 100% {
    box-shadow: 0 12rpx 40rpx rgba(124, 58, 237, 0.3), 0 0 60rpx rgba(124, 58, 237, 0.2);
  }
  50% {
    box-shadow: 0 12rpx 40rpx rgba(124, 58, 237, 0.3), 0 0 100rpx rgba(124, 58, 237, 0.4);
  }
}

.logo-icon {
  font-size: 90rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #4C1D95;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.app-slogan {
  font-size: 28rpx;
  color: #6B21A8;
  margin-bottom: 25rpx;
  font-weight: 500;
}

.app-version {
  font-size: 26rpx;
  color: #7C3AED;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  padding: 12rpx 28rpx;
  border-radius: 25rpx;
  font-weight: 600;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

/* 信息区块 - Glassmorphism卡片 */
.info-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  margin: 0 0 30rpx;
  border-radius: 24rpx;
  padding: 35rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  animation: fadeInUp 0.6s ease;
  animation-delay: 0.1s;
  animation-fill-mode: both;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4C1D95;
  margin-bottom: 25rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid rgba(124, 58, 237, 0.1);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #7C3AED 0%, #A78BFA 100%);
  border-radius: 3rpx;
}

.section-content {
  line-height: 1.8;
}

.content-text {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.8;
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.05) 0%, rgba(167, 139, 250, 0.05) 100%);
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(124, 58, 237, 0.1);
}

.feature-item:active {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  transform: translateX(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.15);
}

.feature-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 功能图标配色 */
.feature-item:nth-child(1) .feature-icon {
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
}

.feature-item:nth-child(2) .feature-icon {
  background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%);
}

.feature-item:nth-child(3) .feature-icon {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
}

.feature-item:nth-child(4) .feature-icon {
  background: linear-gradient(135deg, #06B6D4 0%, #22D3EE 100%);
}

.feature-info {
  flex: 1;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.1);
  transition: all 0.3s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item:active {
  background: rgba(124, 58, 237, 0.03);
  border-radius: 12rpx;
  padding: 28rpx 15rpx;
  margin: 0 -15rpx;
}

.contact-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.contact-item:nth-child(1) .contact-icon {
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
}

.contact-item:nth-child(2) .contact-icon {
  background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%);
}

.contact-item:nth-child(3) .contact-icon {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
}

.contact-label {
  font-size: 28rpx;
  color: #374151;
  width: 160rpx;
  font-weight: 600;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #6B7280;
}

.contact-arrow {
  font-size: 28rpx;
  color: #7C3AED;
  margin-left: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 58, 237, 0.1);
  transition: all 0.3s ease;
}

.contact-item:active .contact-arrow {
  background: rgba(124, 58, 237, 0.2);
  transform: translateX(5rpx);
}

/* 更新日志 */
.changelog-list {
  display: flex;
  flex-direction: column;
}

.changelog-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.1);
  transition: all 0.3s ease;
}

.changelog-item:last-child {
  border-bottom: none;
}

.changelog-item:active {
  background: rgba(124, 58, 237, 0.03);
  border-radius: 12rpx;
  padding: 28rpx 15rpx;
  margin: 0 -15rpx;
}

.changelog-version {
  font-size: 30rpx;
  font-weight: 700;
  color: #7C3AED;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.changelog-version::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  background: #7C3AED;
  border-radius: 50%;
}

.changelog-date {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 18rpx;
  font-weight: 500;
}

.changelog-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.changelog-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  padding-left: 20rpx;
  border-left: 3rpx solid rgba(124, 58, 237, 0.2);
}

/* 底部版权信息 - Glassmorphism风格 */
.footer-section {
  padding: 50rpx 30rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.copyright {
  font-size: 26rpx;
  color: #4B5563;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.icp {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: 40rpx 20rpx 25rpx;
  }

  .content-area {
    padding: 120rpx 20rpx 40rpx;
  }

  .logo-section {
    padding: 50rpx 30rpx;
    border-radius: 24rpx;
  }

  .logo-container {
    width: 150rpx;
    height: 150rpx;
    border-radius: 35rpx;
  }

  .logo-icon {
    font-size: 75rpx;
  }

  .app-name {
    font-size: 38rpx;
  }

  .info-section {
    padding: 28rpx;
    border-radius: 20rpx;
  }

  .feature-item {
    padding: 20rpx;
  }

  .feature-icon {
    width: 60rpx;
    height: 60rpx;
    font-size: 32rpx;
  }

  .contact-item {
    padding: 22rpx 0;
  }

  .footer-section {
    padding: 40rpx 20rpx;
  }
}
