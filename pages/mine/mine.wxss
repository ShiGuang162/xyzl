/* 个人主页 - 现代优雅风格 */
page {
  background: linear-gradient(180deg, #FAFAFA 0%, #F5F5F5 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户信息区域 - 深色优雅头部 */
.user-section {
  background: linear-gradient(135deg, #18181B 0%, #27272A 50%, #3F3F46 100%);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  align-items: center;
  color: white;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(24, 24, 27, 0.3);
  position: relative;
  overflow: hidden;
}

.user-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-section::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

/* 头像容器 */
.avatar-container {
  position: relative;
  margin-right: 35rpx;
  z-index: 1;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.avatar-container:active .user-avatar {
  transform: scale(0.95);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.4);
  margin-top: -15rpx;
}

.avatar-edit-text {
  font-size: 20rpx;
  color: white;
  font-weight: 600;
  white-space: nowrap;
}

/* 用户信息 */
.user-info {
  flex: 1;
  z-index: 1;
}

.user-name {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.edit-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: pencilFloat 2s ease-in-out infinite;
}

@keyframes pencilFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-4rpx) rotate(5deg);
  }
}

.user-name:active .edit-icon,
.user-id:active .edit-icon {
  transform: scale(1.15) rotate(15deg);
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.6);
  animation: none;
}

.user-id {
  font-size: 26rpx;
  opacity: 0.8;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  transition: all 0.3s ease;
  z-index: 1;
}

.login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

/* 功能模块 - 玻璃拟态卡片 */
.module-section {
  margin: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: fadeInUp 0.5s ease;
}

.module-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18181B;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 3rpx;
}

/* 模块网格 */
.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 30rpx 20rpx;
  gap: 20rpx;
}

.module-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(59, 130, 246, 0.02) 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.module-item:active {
  transform: translateY(-4rpx) scale(0.98);
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.15);
}

.module-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.3);
  transition: all 0.3s ease;
}

.module-item:active .module-icon {
  transform: scale(1.1);
}

.module-text {
  font-size: 26rpx;
  color: #3F3F46;
  font-weight: 600;
}

.module-arrow {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #2563EB;
}

/* 模块列表 */
.module-list {
  padding: 10rpx 0;
}

.module-list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.module-list-item:last-child {
  border-bottom: none;
}

.module-list-item:active {
  background: rgba(37, 99, 235, 0.03);
}

.module-list-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 设置图标 - 灰色渐变 */
.module-list-item:nth-child(1) .module-list-icon {
  background: linear-gradient(135deg, #6B7280 0%, #4B5563 100%);
  color: white;
}

/* 我的购买图标 - 橙色渐变 */
.module-list-item:nth-child(2) .module-list-icon {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: white;
}

/* 客服中心图标 - 绿色渐变 */
.module-list-item:nth-child(3) .module-list-icon {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: white;
}

/* 关于我们图标 - 紫色渐变 */
.module-list-item:nth-child(4) .module-list-icon {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
  color: white;
}

.module-list-item:active .module-list-icon {
  transform: scale(1.1) rotate(5deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.module-list-text {
  flex: 1;
  font-size: 30rpx;
  color: #18181B;
  font-weight: 500;
}

.module-list-arrow {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9CA3AF;
  background: rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
}

.module-list-item:active .module-list-arrow {
  background: rgba(37, 99, 235, 0.1);
  color: #2563EB;
  transform: translateX(4rpx);
}

/* 退出登录 */
.logout-btn {
  margin: 40rpx 30rpx;
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  color: #DC2626;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(220, 38, 38, 0.15);
  border: 1rpx solid rgba(220, 38, 38, 0.1);
  transition: all 0.3s ease;
}

.logout-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(220, 38, 38, 0.1);
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 用户信息区域动画 */
.user-section {
  animation: slideDown 0.6s ease;
}

/* 功能模块动画 */
.module-section:nth-child(2) {
  animation-delay: 0.1s;
}

.module-section:nth-child(3) {
  animation-delay: 0.2s;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .user-section {
    padding: 50rpx 30rpx 40rpx;
  }
  
  .user-avatar {
    width: 140rpx;
    height: 140rpx;
  }
  
  .user-name {
    font-size: 38rpx;
  }
  
  .module-grid {
    padding: 25rpx 15rpx;
  }
  
  .module-item {
    padding: 25rpx 15rpx;
  }
  
  .module-icon {
    width: 70rpx;
    height: 70rpx;
    font-size: 36rpx;
  }
}
