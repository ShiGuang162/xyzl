/* 个人主页 - 现代优雅风格 */
page {
  background: linear-gradient(180deg, #FAFAFA 0%, #F5F5F5 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户信息区域 - 深色优雅头部 */
.user-section {
  background: linear-gradient(135deg, #18181B 0%, #27272A 50%, #3F3F46 100%);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  align-items: center;
  color: white;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(24, 24, 27, 0.3);
  position: relative;
  overflow: hidden;
}

.user-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-section::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

/* 头像容器 */
.avatar-container {
  position: relative;
  margin-right: 35rpx;
  z-index: 1;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.avatar-container:active .user-avatar {
  transform: scale(0.95);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.4);
  margin-top: -15rpx;
}

.avatar-edit-text {
  font-size: 20rpx;
  color: white;
  font-weight: 600;
  white-space: nowrap;
}

/* 用户信息 */
.user-info {
  flex: 1;
  z-index: 1;
}

.user-name {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.edit-icon {
  font-size: 28rpx;
  opacity: 0.7;
  transition: all 0.3s ease;
}

.user-name:active .edit-icon {
  opacity: 1;
  transform: scale(1.1);
}

.user-id {
  font-size: 26rpx;
  opacity: 0.8;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  transition: all 0.3s ease;
  z-index: 1;
}

.login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

/* 功能模块 - 玻璃拟态卡片 */
.module-section {
  margin: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: fadeInUp 0.5s ease;
}

.module-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18181B;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 3rpx;
}

/* 模块网格 */
.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 30rpx 20rpx;
  gap: 20rpx;
}

.module-item {
  display: flex