/* 设置页面样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #2c3e50;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-back:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 30rpx;
  font-weight: bold;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

/* 主内容区域 */
.content-area {
  padding: 120rpx 0 30rpx;
}

/* 设置区块 */
.setting-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 24rpx;
  color: #666;
  padding: 0 30rpx 15rpx;
}

.setting-list {
  background-color: white;
  border-radius: 10rpx;
  margin: 0 30rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:hover {
  background-color: #f9f9f9;
}

.setting-label {
  font-size: 26rpx;
  color: #333;
}

.setting-value {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.setting-arrow {
  font-size: 24rpx;
  color: #999;
}

.setting-switch {
  display: flex;
  align-items: center;
}

/* 退出登录区域 */
.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  width: 100%;
  padding: 25rpx;
  background-color: #e74c3c;
  color: white;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 10rpx rgba(231, 76, 60, 0.2);
}

.logout-btn:hover {
  background-color: #c0392b;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 15rpx rgba(231, 76, 60, 0.3);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: 15rpx 20rpx;
  }
  
  .content-area {
    padding: 100rpx 0 20rpx;
  }
  
  .setting-list {
    margin: 0 20rpx;
  }
  
  .setting-item {
    padding: 20rpx 25rpx;
  }
  
  .logout-section {
    padding: 30rpx 20rpx;
  }
}