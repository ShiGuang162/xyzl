/* 产品详情页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  padding-bottom: 150rpx;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  flex: 1;
  text-align: center;
}

.nav-share {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

.share-icon {
  font-size: 32rpx;
  color: white;
}

/* 产品图片 */
.product-images {
  position: relative;
  background-color: white;
}

.image-scroll {
  white-space: nowrap;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}

.image-container {
  display: inline-block;
  width: 100vw;
  height: 60vh;
  scroll-snap-align: start;
}

.image-container image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-indicators {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.indicator {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.indicator.active {
  width: 40rpx;
  border-radius: 10rpx;
  background-color: white;
}

/* 产品信息 */
.product-info {
  background-color: white;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.product-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 20rpx;
}

.product-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #f8f8f8;
  padding: 8rpx 15rpx;
  border-radius: 15rpx;
}

.stat-icon {
  font-size: 24rpx;
}

.product-badges {
  display: flex;
  gap: 15rpx;
}

.badge {
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: white;
}

.badge.hot {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
}

.badge.new {
  background: linear-gradient(135deg, #4ecdc4 0%, #45b7d1 100%);
}

/* 产品描述 */
.product-description {
  background-color: white;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.description-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 产品评价 */
.product-reviews {
  background-color: white;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.no-reviews {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  color: #999;
}

.no-reviews-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.no-reviews-text {
  font-size: 26rpx;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.review-user {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.review-rating {
  display: flex;
  gap: 5rpx;
}

.star {
  font-size: 20rpx;
  color: #ddd;
}

.star.active {
  color: #ffd700;
}

.review-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.review-time {
  font-size: 20rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 90;
}

.quantity-control {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  overflow: hidden;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
  background-color: #f0f0f0;
}

.quantity {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  background-color: white;
}

.action-buttons {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.add-to-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 15rpx;
}

.buy-now {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 15rpx;
}

/* 加载提示 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 30rpx 60rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1000;
}

.loading-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 26rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 响应式 */
@media (max-width: 375px) {
  .image-container {
    height: 50vh;
  }
  
  .product-stats {
    flex-direction: column;
    gap: 10rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
}
