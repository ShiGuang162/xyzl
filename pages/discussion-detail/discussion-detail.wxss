/* 讨论详情页 - 现代Glassmorphism风格 */
page {
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
  padding-bottom: 40rpx;
}

/* 顶部导航栏 - Glassmorphism风格 */
.nav-bar {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 110rpx;
  padding: 40rpx 30rpx 20rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 50%, #A78BFA 100%);
  color: white;
  box-shadow: 0 10rpx 40rpx rgba(124, 58, 237, 0.3);
  z-index: 100;
  border-radius: 0 0 30rpx 30rpx;
}

.nav-back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.back-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: white;
  flex: 1;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.nav-right {
  width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.share-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.share-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.share-icon {
  font-size: 32rpx;
  color: white;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.loading-spinner {
  width: 70rpx;
  height: 70rpx;
  border: 6rpx solid rgba(124, 58, 237, 0.1);
  border-top: 6rpx solid #7C3AED;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 25rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #7C3AED;
  font-weight: 500;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 讨论容器 - Glassmorphism卡片 */
.discussion-container {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  margin: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 讨论头部 */
.discussion-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 35rpx 30rpx 25rpx;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 25rpx;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.3);
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4C1D95;
  margin-bottom: 8rpx;
}

.post-time {
  font-size: 24rpx;
  color: #8B5CF6;
}

.post-tag {
  padding: 12rpx 24rpx;
  border-radius: 25rpx;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  color: #7C3AED;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

/* 讨论主体 */
.discussion-body {
  padding: 30rpx;
}

.discussion-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.4;
  margin-bottom: 25rpx;
}

.discussion-content {
  font-size: 30rpx;
  color: #4B5563;
  line-height: 1.8;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
}

.discussion-image {
  margin: 30rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.content-image {
  width: 100%;
  height: 450rpx;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.content-image:active {
  transform: scale(1.02);
}

/* 互动数据 - Glassmorphism */
.interaction-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.stat-item:active {
  background: rgba(124, 58, 237, 0.1);
  transform: scale(0.98);
}

.stat-icon {
  font-size: 44rpx;
  transition: all 0.3s ease;
}

.stat-icon.liked {
  transform: scale(1.2);
  animation: heartBeat 0.5s ease;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  25% { transform: scale(1.3); }
  50% { transform: scale(1); }
  75% { transform: scale(1.2); }
  100% { transform: scale(1.2); }
}

.stat-text {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 600;
}

/* 评论区域 - Glassmorphism */
.comments-section {
  margin: 0 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  padding: 35rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(124, 58, 237, 0.1);
}

.comments-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4C1D95;
}

.comments-list {
  margin-bottom: 30rpx;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #8B5CF6;
  font-size: 28rpx;
  font-weight: 500;
}

.no-comments-text {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.05) 0%, rgba(167, 139, 250, 0.05) 100%);
  padding: 40rpx;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(124, 58, 237, 0.2);
}

.comment-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.08);
  animation: slideUp 0.4s ease;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #A78BFA 0%, #C4B5FD 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(167, 139, 250, 0.3);
}

.comment-content {
  flex: 1;
  background: rgba(124, 58, 237, 0.03);
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.comment-user {
  font-size: 28rpx;
  font-weight: 700;
  color: #4C1D95;
}

.comment-time {
  font-size: 22rpx;
  color: #8B5CF6;
}

.comment-text {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 评论输入框 - Glassmorphism固定底部 */
.comment-input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 30rpx;
  padding-bottom: calc(25rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 -4rpx 20rpx rgba(124, 58, 237, 0.08);
  z-index: 100;
}

.comment-input {
  flex: 1;
  position: relative;
}

.input-text {
  width: 100%;
  padding: 22rpx 30rpx;
  border-radius: 35rpx;
  background: rgba(124, 58, 237, 0.08);
  border: 2rpx solid rgba(124, 58, 237, 0.15);
  font-size: 28rpx;
  color: #1F2937;
  transition: all 0.3s ease;
}

.input-text:focus {
  outline: none;
  border-color: #7C3AED;
  background: rgba(124, 58, 237, 0.05);
  box-shadow: 0 0 0 4rpx rgba(124, 58, 237, 0.1);
}

.input-text::placeholder {
  color: #8B5CF6;
}

.send-btn {
  padding: 22rpx 45rpx;
  border-radius: 35rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.3);
  transition: all 0.3s ease;
}

.send-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.2);
}

/* 无内容状态 - Glassmorphism */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  margin: 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.empty-icon {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 35rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 10rpx 30rpx rgba(124, 58, 237, 0.3);
}

.empty-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #4C1D95;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8B5CF6;
}

/* 内容底部间距（为固定输入框留空间） */
.content-spacer {
  height: 140rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .discussion-title {
    font-size: 32rpx;
  }
  
  .discussion-content {
    font-size: 26rpx;
  }
  
  .content-image {
    height: 350rpx;
  }
  
  .stat-icon {
    font-size: 38rpx;
  }
  
  .comment-text {
    font-size: 26rpx;
  }
  
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
    font-size: 32rpx;
  }
  
  .comment-avatar {
    width: 60rpx;
    height: 60rpx;
    font-size: 24rpx;
  }
}
