/* 搜索结果页面样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  background-color: #2c3e50;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.search-input-container {
  flex: 1;
  background-color: white;
  border-radius: 20rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  padding: 15rpx 0;
  font-size: 30rpx;
  color: #333;
}

.clear-icon {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
  cursor: pointer;
  transition: color 0.3s ease;
}

.clear-icon:hover {
  color: #e74c3c;
}

/* 搜索结果标题 */
.result-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.title-keyword {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: bold;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 无结果状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 搜索结果列表 */
.result-list {
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.result-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.3s ease;
  cursor: pointer;
}

.result-item:hover {
  background-color: #f9f9f9;
}

.result-item:last-child {
  border-bottom: none;
}

.result-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  object-fit: cover;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.result-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .result-title {
    flex-direction: column;
    align-items: flex-start;
    gap: 10rpx;
  }
  
  .result-item {
    flex-direction: column;
  }
  
  .result-image {
    width: 100%;
    height: 200rpx;
    margin-right: 0;
    margin-bottom: 15rpx;
  }
  
  .result-info {
    width: 100%;
  }
}

/* 动画效果 */
.result-item {
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-item:nth-child(1) {
  animation-delay: 0.1s;
}

.result-item:nth-child(2) {
  animation-delay: 0.2s;
}

.result-item:nth-child(3) {
  animation-delay: 0.3s;
}
