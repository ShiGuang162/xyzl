<!-- 攻略页面 -->
<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="title">旅游攻略</view>
  </view>
  
  <view class="strategy-list">
    <view class="strategy-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=travel%20guide%20photo%2C%20beautiful%20scenery%2C%20professional%20photography&image_size=landscape_16_9" class="strategy-image" />
      <view class="strategy-info">
        <view class="strategy-title">经典一日游攻略</view>
        <view class="strategy-desc">带你游览当地最具特色的景点，体验传统文化</view>
        <view class="strategy-tags">
          <view class="tag">热门</view>
          <view class="tag">经典</view>
        </view>
      </view>
    </view>
    
    <view class="strategy-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=food%20tour%20guide%2C%20local%20delicacies%2C%20colorful%20dishes&image_size=landscape_16_9" class="strategy-image" />
      <view class="strategy-info">
        <view class="strategy-title">美食之旅攻略</view>
        <view class="strategy-desc">品尝当地特色美食，了解饮食文化</view>
        <view class="strategy-tags">
          <view class="tag">美食</view>
          <view class="tag">推荐</view>
        </view>
      </view>
    </view>
    
    <view class="strategy-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cultural%20tour%20guide%2C%20ancient%20buildings%2C%20traditional%20culture&image_size=landscape_16_9" class="strategy-image" />
      <view class="strategy-info">
        <view class="strategy-title">文化探索攻略</view>
        <view class="strategy-desc">深入了解当地历史文化，参观博物馆和古迹</view>
        <view class="strategy-tags">
          <view class="tag">文化</view>
          <view class="tag">历史</view>
        </view>
      </view>
    </view>
  </view>
</view>