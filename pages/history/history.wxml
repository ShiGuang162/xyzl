<!-- 历史页面 -->
<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="title">历史文化</view>
  </view>
  
  <view class="history-list">
    <view class="history-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=ancient%20chinese%20history%20relic%2C%20cultural%20heritage%2C%20professional%20photography&image_size=landscape_16_9" class="history-image" />
      <view class="history-info">
        <view class="history-title">历史遗迹</view>
        <view class="history-desc">承载着悠久的历史文化，见证了时代的变迁</view>
        <view class="history-tags">
          <view class="tag">文物</view>
          <view class="tag">历史</view>
        </view>
      </view>
    </view>
    
    <view class="history-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=traditional%20chinese%20culture%20performance%2C%20colorful%20costumes%2C%20traditional%20music&image_size=landscape_16_9" class="history-image" />
      <view class="history-info">
        <view class="history-title">传统文化</view>
        <view class="history-desc">丰富多彩的传统习俗和文化活动，传承着民族精神</view>
        <view class="history-tags">
          <view class="tag">文化</view>
          <view class="tag">传统</view>
        </view>
      </view>
    </view>
    
    <view class="history-item">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=ancient%20chinese%20literature%20and%20artifacts%2C%20old%20books%2C%20traditional%20calligraphy&image_size=landscape_16_9" class="history-image" />
      <view class="history-info">
        <view class="history-title">名人典故</view>
        <view class="history-desc">历史名人的故事和传说，丰富了当地的文化内涵</view>
        <view class="history-tags">
          <view class="tag">名人</view>
          <view class="tag">故事</view>
        </view>
      </view>
    </view>
  </view>
</view>