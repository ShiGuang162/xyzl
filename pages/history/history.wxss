/* 历史页面样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部 */
.header {
  background-color: #2c3e50;
  color: white;
  padding: 20rpx;
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  font-size: 40rpx;
  margin-right: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

/* 历史列表 */
.history-list {
  padding: 20rpx;
}

.history-item {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.history-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.history-info {
  padding: 20rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.history-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15rpx;
}

.history-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  background-color: #f0f0f0;
  color: #666;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}