/* 首页样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  background-color: #2c3e50;
  padding: 15rpx 20rpx;
  display: flex;
  align-items: center;
}

.location-container {
  display: flex;
  align-items: center;
  margin-right: 15rpx;
  color: white;
  cursor: pointer;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 28rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-input-container {
  background-color: white;
  border-radius: 20rpx;
  padding: 0 20rpx;
  flex: 1;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  padding: 10rpx 0;
  font-size: 30rpx;
}

.clear-icon {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
  padding: 5rpx;
  cursor: pointer;
}

/* 搜索结果区域 */
.search-results-container {
  background-color: white;
  min-height: 500rpx;
  padding: 20rpx;
}

.search-results-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.search-results-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-result-item {
  display: flex;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  overflow: hidden;
  padding: 15rpx;
  cursor: pointer;
}

.search-result-item:hover {
  background-color: #f0f0f0;
}

.search-result-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.search-result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.search-result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.search-result-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.search-results-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.search-results-empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.search-results-empty-text {
  font-size: 28rpx;
}

/* 轮播图 */
.swiper {
  height: 300rpx;
  width: 100%;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.swiper-title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .swiper {
    height: 250rpx;
  }
  
  .swiper-title {
    font-size: 28rpx;
    padding: 15rpx;
  }
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  padding: 15rpx 0;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.tab-item:hover {
  color: #2c3e50;
  background-color: #f0f0f0;
}

.tab-item.active {
  color: #2c3e50;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #2c3e50;
  border-radius: 2rpx;
  animation: slideIn 0.3s ease;
}

/* 按钮点击效果 */
button {
  transition: all 0.3s ease;
}

button:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 卡片悬停效果增强 */
.recommend-item,
.strategy-item,
.scenic-item,
.history-item {
  transition: all 0.3s ease;
  cursor: pointer;
}

.recommend-item:active,
.strategy-item:active,
.scenic-item:active,
.history-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 搜索输入框动画 */
.search-input-container {
  transition: all 0.3s ease;
}

.search-input-container:focus-within {
  box-shadow: 0 0 10rpx rgba(44, 62, 80, 0.2);
}

/* 加载动画增强 */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes slideIn {
  from { width: 0; left: 50%; }
  to { width: 50%; left: 25%; }
}

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.content-section {
  animation: fadeIn 0.5s ease;
}

/* 轮播图动画增强 */
.swiper-item {
  animation: fadeIn 0.5s ease;
}

/* 推荐项动画 */
.recommendation-item {
  animation: fadeIn 0.5s ease;
}

.recommendation-item:nth-child(1) {
  animation-delay: 0.1s;
}

.recommendation-item:nth-child(2) {
  animation-delay: 0.2s;
}

.recommendation-item:nth-child(3) {
  animation-delay: 0.3s;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #666;
}

/* 内容区域 */
.content-container {
  min-height: 500rpx;
}

.content-section {
  padding: 20rpx;
  animation: fadeIn 0.5s ease;
}

/* 推荐内容 */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.recommend-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.1);
}

.recommend-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.recommend-info {
  padding: 20rpx;
}

.recommend-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.recommend-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.recommend-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.recommend-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-stats {
  display: flex;
  gap: 20rpx;
}

.recommend-view,
.recommend-like,
.recommend-rating,
.recommend-reviews {
  font-size: 22rpx;
  color: #999;
}

/* 攻略内容 */
.strategy-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.strategy-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strategy-stats {
  display: flex;
  gap: 20rpx;
}

.strategy-view,
.strategy-like {
  font-size: 22rpx;
  color: #999;
}

/* 景点内容 */
.scenic-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.scenic-address {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scenic-stats {
  display: flex;
  gap: 20rpx;
}

.scenic-rating,
.scenic-reviews {
  font-size: 22rpx;
  color: #999;
}
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.strategy-item {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.strategy-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.1);
}

.strategy-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.strategy-info {
  padding: 20rpx;
}

.strategy-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.strategy-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 景点内容 */
.scenic-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scenic-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.scenic-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.1);
}

.scenic-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.scenic-info {
  flex: 1;
}

.scenic-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.scenic-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 历史内容 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.history-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.1);
}

.history-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.history-info {
  padding: 20rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.history-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 动画效果 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes slideIn {
  from { width: 0; left: 50%; }
  to { width: 50%; left: 25%; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .tab-item {
    font-size: 28rpx;
    padding: 12rpx 0;
  }
  
  .recommend-title,
  .strategy-title,
  .scenic-name,
  .history-title {
    font-size: 28rpx;
  }
  
  .recommend-desc,
  .strategy-desc,
  .scenic-desc,
  .history-desc {
    font-size: 24rpx;
  }
  
  .recommend-image,
  .strategy-image,
  .history-image {
    height: 200rpx;
  }
  
  .scenic-image {
    width: 120rpx;
    height: 120rpx;
  }
}

@media (min-width: 751rpx) {
  .container {
    max-width: 750rpx;
    margin: 0 auto;
    box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1);
  }
}