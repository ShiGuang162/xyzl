/* 首页样式 */
:root {
  --primary-color: #1a365d;
  --secondary-color: #2b6cb0;
  --accent-color: #4299e1;
  --text-primary: #1a202c;
  --text-secondary: #4a5568;
  --text-muted: #718096;
  --background: #f7fafc;
  --card-bg: #ffffff;
  --border-radius: 16rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.container {
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  position: relative;
}

/* 背景装饰 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: 
    radial-gradient(circle at 10% 20%, rgba(74, 85, 102, 0.03) 0%, transparent 20%),
    radial-gradient(circle at 90% 80%, rgba(66, 153, 225, 0.03) 0%, transparent 20%);
  pointer-events: none;
  z-index: 0;
}

/* 搜索栏 */
.search-bar {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  padding: 20rpx 25rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(26, 54, 93, 0.3);
  position: sticky;
  top: 0;
  z-index: 100;
  border-radius: 0 0 32rpx 32rpx;
}

.location-container {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  color: white;
  cursor: pointer;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  transition: var(--transition);
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.location-container:active {
  background: rgba(255, 255, 255, 0.18);
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(255, 255, 255, 0.15);
}

.location-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  animation: pulse 2s infinite;
}

.location-text {
  font-size: 28rpx;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.search-input-container {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  flex: 1;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: var(--transition);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.search-input-container:focus-within {
  box-shadow: 0 8rpx 32rpx rgba(26, 54, 93, 0.3);
  transform: translateY(-4rpx);
  background: rgba(255, 255, 255, 1);
}

.search-icon {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-right: 12rpx;
  transition: var(--transition);
}

.search-input-container:focus-within .search-icon {
  color: var(--accent-color);
  transform: scale(1.1);
}

.search-input {
  flex: 1;
  padding: 12rpx 0;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.search-input::placeholder {
  color: var(--text-muted);
  font-weight: 300;
}

.clear-icon {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
  padding: 8rpx;
  cursor: pointer;
  transition: var(--transition);
  border-radius: 50%;
}

.clear-icon:active {
  background: rgba(113, 128, 150, 0.1);
  transform: scale(0.9);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

/* 搜索结果区域 */
.search-results-container {
  background-color: white;
  min-height: 500rpx;
  padding: 20rpx;
}

.search-results-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.search-results-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-result-item {
  display: flex;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  overflow: hidden;
  padding: 15rpx;
  cursor: pointer;
}

.search-result-item:hover {
  background-color: #f0f0f0;
}

.search-result-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.search-result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.search-result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.search-result-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.search-results-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.search-results-empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.search-results-empty-text {
  font-size: 28rpx;
}

/* 轮播图 */
.swiper {
  height: 420rpx;
  width: 94%;
  margin: 30rpx auto;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
  position: relative;
  backdrop-filter: blur(10rpx);
}

.swiper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(26, 54, 93, 0.1) 0%, rgba(43, 108, 176, 0.1) 100%);
  z-index: 1;
  pointer-events: none;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 24rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.swiper-item:active .swiper-image {
  transform: scale(1.05);
}

.swiper-title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 40rpx 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
  color: white;
  font-size: 42rpx;
  font-weight: bold;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.6);
  z-index: 2;
  animation: slideUp 0.6s ease-out;
}

/* 轮播图指示器增强 */
.swiper .wx-swiper-dots {
  bottom: 20rpx;
  z-index: 3;
}

.swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 6rpx;
  transition: var(--transition);
}

.swiper .wx-swiper-dot-active {
  width: 36rpx;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.5);
}

@keyframes slideUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .swiper {
    height: 300rpx;
  }
  
  .swiper-title {
    font-size: 32rpx;
    padding: 20rpx;
  }
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx;
  margin: 0 25rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 140rpx;
  z-index: 90;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-muted);
  padding: 16rpx 12rpx;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
  border-radius: 16rpx;
  margin: 0 8rpx;
  font-weight: 500;
  background: rgba(247, 250, 252, 0.6);
}

.tab-item:active {
  background: rgba(26, 54, 93, 0.12);
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.15);
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
  background: linear-gradient(135deg, rgba(26, 54, 93, 0.15) 0%, rgba(43, 108, 176, 0.15) 100%);
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.1);
  transform: translateY(-2rpx);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
  border-radius: 2rpx;
  animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(66, 153, 225, 0.4);
}

.tab-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 100%);
  pointer-events: none;
  opacity: 0;
  transition: var(--transition);
}

.tab-item.active::before {
  opacity: 1;
}

/* 按钮点击效果 */
button {
  transition: all 0.3s ease;
}

button:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 卡片悬停效果增强 */
.recommend-item,
.strategy-item,
.scenic-item,
.history-item {
  transition: all 0.3s ease;
  cursor: pointer;
}

.recommend-item:active,
.strategy-item:active,
.scenic-item:active,
.history-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 搜索输入框动画 */
.search-input-container {
  transition: all 0.3s ease;
}

.search-input-container:focus-within {
  box-shadow: 0 0 10rpx rgba(44, 62, 80, 0.2);
}

/* 加载动画增强 */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes slideIn {
  from { width: 0; left: 50%; }
  to { width: 50%; left: 25%; }
}

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.content-section {
  animation: fadeIn 0.5s ease;
}

/* 轮播图动画增强 */
.swiper-item {
  animation: fadeIn 0.5s ease;
}

/* 推荐项动画 */
.recommendation-item {
  animation: fadeIn 0.5s ease;
}

.recommendation-item:nth-child(1) {
  animation-delay: 0.1s;
}

.recommendation-item:nth-child(2) {
  animation-delay: 0.2s;
}

.recommendation-item:nth-child(3) {
  animation-delay: 0.3s;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  background: rgba(255, 255, 255, 0.95);
  margin: 25rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.loading-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(66, 153, 225, 0.1), transparent);
  animation: shimmer 2s infinite;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(247, 250, 252, 0.8);
  border-top: 8rpx solid var(--accent-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 153, 225, 0.3);
  position: relative;
  z-index: 1;
}

.loading-spinner::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: var(--accent-color);
  border-radius: 50%;
  box-shadow: 0 0 12rpx var(--accent-color);
  animation: pulse 1.5s infinite;
}

.loading-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 500;
  position: relative;
  z-index: 1;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* 内容区域 */
.content-container {
  min-height: 500rpx;
  padding: 0 20rpx 20rpx;
}

.content-section {
  animation: fadeIn 0.5s ease;
}

/* 推荐内容 */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 25rpx;
}

.recommend-item {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: var(--transition);
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transform-origin: center;
}

.recommend-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--accent-color), var(--primary-color));
  box-shadow: 0 2rpx 12rpx rgba(66, 153, 225, 0.4);
}

.recommend-item::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.4) 100%);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  opacity: 0;
  transition: var(--transition);
  z-index: 1;
}

.recommend-item:active {
  transform: translateY(-8rpx) scale(0.98);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.recommend-item:active::after {
  opacity: 1;
  transform: scale(1.1);
}

.recommend-image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 0;
}

.recommend-item:active .recommend-image {
  transform: scale(1.03);
}

.recommend-info {
  padding: 30rpx;
  position: relative;
  z-index: 2;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 1) 100%);
}

.recommend-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.recommend-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 300;
}

.recommend-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  position: relative;
}

.recommend-meta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, var(--accent-color), transparent);
}

.recommend-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  color: var(--secondary-color);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recommend-author::before {
  content: '👤';
  font-size: 22rpx;
}

.recommend-stats {
  display: flex;
  gap: 30rpx;
  align-items: center;
}

.recommend-view, .recommend-like, .recommend-rating, .recommend-reviews {
  font-size: 24rpx;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: var(--transition);
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(247, 250, 252, 0.8) 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.recommend-view:active,
.recommend-like:active,
.recommend-rating:active,
.recommend-reviews:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 浏览图标 */
.recommend-view::before {
  content: '👁';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 2rpx 6rpx rgba(102, 126, 234, 0.3);
  animation: pulse-blue 2s infinite;
}

/* 点赞图标 */
.recommend-like::before {
  content: '♥';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  box-shadow: 0 2rpx 6rpx rgba(245, 87, 108, 0.3);
  animation: heartbeat 1.5s infinite;
}

/* 评分图标 */
.recommend-rating::before {
  content: '★';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7b731 0%, #f5af19 100%);
  box-shadow: 0 2rpx 6rpx rgba(247, 183, 49, 0.3);
}

/* 评论图标 */
.recommend-reviews::before {
  content: '✉';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  box-shadow: 0 2rpx 6rpx rgba(79, 172, 254, 0.3);
}

@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
  }
  25% {
    transform: scale(1.15);
  }
  50% {
    transform: scale(1);
  }
  75% {
    transform: scale(1.1);
  }
}

@keyframes pulse-blue {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.9;
  }
}

/* 攻略内容 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 25rpx;
}

.strategy-item {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: var(--transition);
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.strategy-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--accent-color), var(--primary-color));
  box-shadow: 0 2rpx 12rpx rgba(66, 153, 225, 0.4);
}

.strategy-item:active {
  transform: translateY(-8rpx) scale(0.98);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.strategy-image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.strategy-item:active .strategy-image {
  transform: scale(1.03);
}

.strategy-info {
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 1) 100%);
}

.strategy-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.strategy-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 300;
}

.strategy-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  position: relative;
}

.strategy-meta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, var(--accent-color), transparent);
}

.strategy-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  color: var(--secondary-color);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.strategy-author::before {
  content: '👤';
  font-size: 22rpx;
}

.strategy-stats {
  display: flex;
  gap: 25rpx;
  align-items: center;
}

.strategy-view,
.strategy-like {
  font-size: 24rpx;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: var(--transition);
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(247, 250, 252, 0.8) 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.strategy-view::before {
  content: '👁';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 2rpx 6rpx rgba(102, 126, 234, 0.3);
  animation: pulse-blue 2s infinite;
}

.strategy-like::before {
  content: '♥';
  font-size: 26rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  box-shadow: 0 2rpx 6rpx rgba(245, 87, 108, 0.3);
  animation: heartbeat 1.5s infinite;
}

.strategy-view:active,
.strategy-like:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 景点内容 */
.scenic-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 25rpx;
}

.scenic-item {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: var(--transition);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.scenic-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--accent-color), var(--primary-color));
  box-shadow: 0 2rpx 12rpx rgba(66, 153, 225, 0.4);
}

.scenic-item:active {
  transform: translateY(-8rpx) scale(0.98);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.scenic-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-right: 25rpx;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
  overflow: hidden;
}

.scenic-item:active .scenic-image {
  transform: scale(1.05);
}

.scenic-info {
  flex: 1;
}

.scenic-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--text-primary);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scenic-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 300;
}

.scenic-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  position: relative;
}

.scenic-meta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, var(--accent-color), transparent);
}

.scenic-address {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  color: var(--secondary-color);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.scenic-address::before {
  content: '📍';
  font-size: 20rpx;
}

.scenic-stats {
  display: flex;
  gap: 25rpx;
  align-items: center;
}

.scenic-rating,
.scenic-reviews {
  font-size: 22rpx;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: var(--transition);
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(247, 250, 252, 0.8) 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.scenic-rating::before {
  content: '★';
  font-size: 22rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7b731 0%, #f5af19 100%);
  box-shadow: 0 2rpx 6rpx rgba(247, 183, 49, 0.3);
}

.scenic-reviews::before {
  content: '✉';
  font-size: 22rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  box-shadow: 0 2rpx 6rpx rgba(79, 172, 254, 0.3);
}

.scenic-rating:active,
.scenic-reviews:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 历史内容 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 25rpx;
}

.history-item {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: var(--transition);
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.history-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--accent-color), var(--primary-color));
  box-shadow: 0 2rpx 12rpx rgba(66, 153, 225, 0.4);
}

.history-item:active {
  transform: translateY(-8rpx) scale(0.98);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.history-image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.history-item:active .history-image {
  transform: scale(1.03);
}

.history-info {
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 1) 100%);
}

.history-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 300;
}

.history-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  position: relative;
}

.history-meta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, var(--accent-color), transparent);
}

.history-period {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  color: var(--secondary-color);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-period::before {
  content: '📅';
  font-size: 22rpx;
}

.history-importance {
  font-size: 24rpx;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: var(--transition);
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(247, 250, 252, 0.6);
}

.history-importance::before {
  content: '⭐';
  font-size: 22rpx;
}

.history-importance:active {
  background: rgba(66, 153, 225, 0.1);
  transform: scale(0.96);
}

/* 动画效果 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes slideIn {
  from { width: 0; left: 50%; }
  to { width: 50%; left: 25%; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .search-bar {
    padding: 16rpx 20rpx;
  }
  
  .location-container {
    padding: 10rpx 14rpx;
    margin-right: 15rpx;
  }
  
  .location-icon {
    font-size: 32rpx;
  }
  
  .location-text {
    font-size: 26rpx;
  }
  
  .search-input-container {
    padding: 14rpx 20rpx;
  }
  
  .search-input {
    font-size: 28rpx;
  }
  
  .swiper {
    height: 350rpx;
    width: 96%;
    margin: 20rpx auto;
  }
  
  .swiper-title {
    font-size: 32rpx;
    padding: 25rpx 20rpx;
  }
  
  .tab-bar {
    margin: 0 20rpx 25rpx;
    padding: 14rpx;
  }
  
  .tab-item {
    font-size: 28rpx;
    padding: 14rpx 10rpx;
    margin: 0 6rpx;
  }
  
  .recommend-list,
  .strategy-list,
  .scenic-list,
  .history-list {
    padding: 0 20rpx;
    gap: 25rpx;
  }
  
  .recommend-item,
  .strategy-item,
  .history-item {
    border-radius: 20rpx;
  }
  
  .recommend-image,
  .strategy-image,
  .history-image {
    height: 280rpx;
  }
  
  .recommend-info,
  .strategy-info,
  .history-info {
    padding: 25rpx;
  }
  
  .recommend-title,
  .strategy-title,
  .scenic-name,
  .history-title {
    font-size: 32rpx;
    margin-bottom: 14rpx;
  }
  
  .recommend-desc,
  .strategy-desc,
  .scenic-desc,
  .history-desc {
    font-size: 26rpx;
    margin-bottom: 16rpx;
  }
  
  .scenic-item {
    padding: 20rpx;
    border-radius: 20rpx;
  }
  
  .scenic-image {
    width: 160rpx;
    height: 160rpx;
    border-radius: 14rpx;
  }
  
  .scenic-info {
    padding: 20rpx;
  }
  
  .loading-container {
    margin: 20rpx;
    padding: 100rpx 0;
    border-radius: 20rpx;
  }
  
  .loading-spinner {
    width: 70rpx;
    height: 70rpx;
    margin-bottom: 25rpx;
  }
  
  .loading-text {
    font-size: 28rpx;
  }
}

@media (max-width: 480rpx) {
  .search-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 15rpx;
    padding: 15rpx 20rpx;
  }
  
  .location-container {
    margin-right: 0;
  }
  
  .search-input-container {
    width: 100%;
  }
  
  .swiper {
    height: 280rpx;
  }
  
  .swiper-title {
    font-size: 28rpx;
  }
  
  .tab-item {
    font-size: 26rpx;
    padding: 12rpx 8rpx;
  }
  
  .recommend-image,
  .strategy-image,
  .history-image {
    height: 240rpx;
  }
  
  .scenic-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 15rpx;
  }
  
  .scenic-image {
    width: 100%;
    height: 200rpx;
    margin-right: 0;
  }
  
  .scenic-info {
    width: 100%;
  }
}

@media (min-width: 751rpx) {
  .container {
    max-width: 750rpx;
    margin: 0 auto;
    box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1);
  }
}