/* 讨论页 - QQ频道风格样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #2c3e50;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  flex: 1;
}

.channel-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.channel-subtitle {
  font-size: 22rpx;
  opacity: 0.8;
}

.nav-right {
  display: flex;
  align-items: center;
}

.search-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.search-btn:hover {
  background-color: rgba(255, 255, 255, 0.3);
  transform: scale(1.1);
}

.search-icon {
  font-size: 24rpx;
}

/* 主内容区域 */
.main-content {
  display: flex;
  min-height: calc(100vh - 120rpx);
}

/* 左侧分类导航 */
.category-nav {
  width: 200rpx;
  background-color: white;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx 0;
  position: fixed;
  left: 0;
  top: 120rpx;
  bottom: 0;
  overflow-y: auto;
  z-index: 10;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25rpx 0;
  margin: 0 15rpx;
  border-radius: 10rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.category-item:hover {
  background-color: #f0f0f0;
}

.category-item.active {
  background-color: #e3f2fd;
  color: #2196f3;
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.category-text {
  font-size: 22rpx;
  font-weight: bold;
}

/* 右侧内容区域 */
.content-area {
  flex: 1;
  margin-left: 200rpx;
  padding: 20rpx;
  overflow-y: auto;
  min-height: calc(100vh - 120rpx);
}

/* 内容标题栏 */
.content-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.header-sort {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.header-sort:hover {
  background-color: #e0e0e0;
}

.sort-text {
  font-size: 22rpx;
  color: #666;
}

.sort-icon {
  font-size: 16rpx;
  color: #666;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2196f3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 无内容状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #ccc;
}

.empty-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 讨论列表 */
.discussion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.discussion-item {
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.discussion-item:hover {
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
  transform: translateY(-2rpx);
}

.discussion-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.user-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: #2c3e50;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-right: 15rpx;
}

.user-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.post-time {
  font-size: 20rpx;
  color: #999;
}

.post-tag {
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
  background-color: #e3f2fd;
  color: #2196f3;
  font-size: 20rpx;
  font-weight: bold;
}

.discussion-content {
  margin-bottom: 15rpx;
}

.discussion-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.discussion-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.discussion-image {
  margin-bottom: 15rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.discussion-img {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.discussion-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.discussion-stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.stat-item:hover {
  color: #2196f3;
}

.stat-icon {
  font-size: 24rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #999;
}

/* 底部发布按钮 */
.post-btn {
  position: fixed;
  bottom: 30rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #2196f3;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(33, 150, 243, 0.4);
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 100;
}

.post-btn:hover {
  background-color: #1976d2;
  transform: scale(1.1);
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.6);
}

.post-icon {
  font-size: 40rpx;
  font-weight: bold;
}

/* 动画效果 */
.category-item {
  animation: fadeIn 0.5s ease;
}

.discussion-item {
  animation: slideUp 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .main-content {
    flex-direction: column;
  }
  
  .category-nav {
    width: 100%;
    height: 120rpx;
    flex-direction: row;
    padding: 0 20rpx;
    overflow-x: auto;
  }
  
  .category-item {
    flex-direction: column;
    align-items: center;
    padding: 15rpx;
    margin: 10rpx;
    min-width: 100rpx;
  }
  
  .content-area {
    flex: 1;
  }
  
  .discussion-img {
    height: 200rpx;
  }
}

/* 搜索对话框样式 */
.search-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: white;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  background-color: white;
  z-index: 1001;
}

.search-input-container {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
}

.search-input-icon {
  font-size: 24rpx;
  color: #999;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding: 15rpx 0;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

.search-clear {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx;
  cursor: pointer;
}

.search-cancel {
  font-size: 28rpx;
  color: #2196f3;
  padding: 10rpx;
  cursor: pointer;
}

/* 搜索历史 */
.search-history {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.search-history-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.search-history-clear {
  font-size: 24rpx;
  color: #999;
  cursor: pointer;
}

.search-history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.search-history-item {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
}

.search-history-item:hover {
  background-color: #e0e0e0;
  color: #333;
}

/* 热门搜索 */
.hot-search {
  padding: 30rpx;
}

.hot-search-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.hot-search-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.hot-search-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.hot-search-item:hover {
  color: #2196f3;
}

.hot-search-rank {
  width: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.hot-search-rank:nth-child(-n+3) {
  color: #ff4757;
}

.hot-search-rank:nth-child(n+4):nth-child(-n+6) {
  color: #ffa502;
}

.hot-search-rank:nth-child(n+7) {
  color: #74b9ff;
}

.hot-search-text {
  font-size: 24rpx;
  color: #666;
}

/* 搜索结果 */
.search-results {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.search-results-header {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.search-results-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-result-item {
  background-color: #f9f9f9;
  border-radius: 10rpx;
  padding: 20rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.search-result-item:hover {
  background-color: #f0f0f0;
}

.search-result-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.search-result-content {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-result-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-result-tag {
  padding: 5rpx 15rpx;
  background-color: #e3f2fd;
  color: #2196f3;
  font-size: 20rpx;
  border-radius: 15rpx;
}

.search-result-time {
  font-size: 20rpx;
  color: #999;
}

/* 无搜索结果 */
.search-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
  text-align: center;
}

.search-empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  color: #ccc;
}

.search-empty-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.search-empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 搜索加载状态 */
.search-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
}

.search-loading .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #2196f3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.search-loading .loading-text {
  font-size: 24rpx;
  color: #666;
}

/* 搜索动画效果 */
.search-dialog {
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.search-result-item {
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 发布讨论对话框样式 */
.post-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-dialog-content {
  width: 85%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  animation: dialogSlideIn 0.3s ease;
}

@keyframes dialogSlideIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.post-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #f9f9f9;
}

.post-dialog-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.post-dialog-close {
  font-size: 28rpx;
  color: #999;
  cursor: pointer;
  padding: 10rpx;
  transition: all 0.3s ease;
}

.post-dialog-close:hover {
  color: #333;
  transform: rotate(90deg);
}

.post-dialog-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.post-form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #333;
  transition: all 0.3s ease;
}

.form-input:focus {
  outline: none;
  border-color: #2196f3;
  box-shadow: 0 0 0 3rpx rgba(33, 150, 243, 0.1);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
  resize: none;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  outline: none;
  border-color: #2196f3;
  box-shadow: 0 0 0 3rpx rgba(33, 150, 243, 0.1);
}

.category-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 10rpx;
}

.category-option {
  padding: 15rpx 25rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 25rpx;
  font-size: 22rpx;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
  background-color: white;
}

.category-option:hover {
  border-color: #2196f3;
  color: #2196f3;
}

.category-option.active {
  border-color: #2196f3;
  color: white;
  background-color: #2196f3;
}

.image-upload {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  background-color: #f9f9f9;
  margin-top: 10rpx;
}

.image-upload:hover {
  border-color: #2196f3;
  background-color: #f0f7ff;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
  color: #ccc;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.image-preview {
  position: relative;
  margin-top: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.preview-img {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.preview-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.preview-remove:hover {
  background-color: rgba(0, 0, 0, 0.8);
  transform: scale(1.1);
}

.post-dialog-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 25rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #f9f9f9;
}

.cancel-btn {
  padding: 15rpx 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
  background-color: white;
}

.cancel-btn:hover {
  border-color: #999;
  color: #333;
}

.submit-btn {
  padding: 15rpx 40rpx;
  border: none;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  background-color: #2196f3;
}

.submit-btn:hover {
  background-color: #1976d2;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.submit-btn:active {
  transform: translateY(0);
}

.submit-btn[disabled] {
  background-color: #ccc;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}
