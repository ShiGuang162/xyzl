/* AI客服小助手页面样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #2c3e50;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-back:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 30rpx;
  font-weight: bold;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.clear-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.clear-btn:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

.clear-text {
  font-size: 24rpx;
}

/* 聊天区域 */
.chat-container {
  flex: 1;
  padding: 120rpx 30rpx 200rpx;
  overflow-y: auto;
}

/* 欢迎消息 */
.welcome-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.welcome-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.welcome-list {
  text-align: left;
  margin-bottom: 30rpx;
}

.welcome-item {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  padding: 5rpx 0;
}

.welcome-tip {
  font-size: 24rpx;
  color: #2196f3;
  background-color: #e3f2fd;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
}

.ai-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.ai-avatar {
  background-color: #e3f2fd;
}

.user-avatar {
  background-color: #2c3e50;
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.message-bubble {
  padding: 20rpx 25rpx;
  border-radius: 15rpx;
  word-wrap: break-word;
  white-space: pre-wrap;
}

.ai-bubble {
  background-color: white;
  border: 1rpx solid #e0e0e0;
  border-top-left-radius: 5rpx;
}

.user-bubble {
  background-color: #2196f3;
  color: white;
  border-top-right-radius: 5rpx;
}

.message-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

/* 正在输入提示 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.typing-bubble {
  background-color: white;
  border: 1rpx solid #e0e0e0;
  border-radius: 15rpx;
  border-top-left-radius: 5rpx;
  padding: 20rpx 25rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #999;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 快捷问题区域 */
.quick-questions {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: white;
  border-top: 1rpx solid #f0f0f0;
}

.quick-scroll {
  white-space: nowrap;
}

.quick-list {
  display: flex;
  gap: 15rpx;
}

.quick-item {
  display: inline-block;
  padding: 15rpx 25rpx;
  background-color: #e3f2fd;
  color: #2196f3;
  border-radius: 25rpx;
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.quick-item:hover {
  background-color: #2196f3;
  color: white;
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: white;
  border-top: 1rpx solid #f0f0f0;
}

.input-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.message-input {
  flex: 1;
  height: 70rpx;
  padding: 0 25rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  font-size: 26rpx;
  color: #333;
}

.send-btn {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.send-btn.active {
  background-color: #2196f3;
}

.send-icon {
  font-size: 30rpx;
  color: white;
  transform: rotate(-45deg);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: 15rpx 20rpx;
  }

  .chat-container {
    padding: 100rpx 20rpx 180rpx;
  }

  .welcome-message {
    padding: 40rpx 30rpx;
  }

  .message-content {
    max-width: 75%;
  }

  .quick-questions {
    padding: 15rpx 20rpx;
  }

  .input-area {
    padding: 15rpx 20rpx;
  }
}