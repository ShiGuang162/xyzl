/* AI客服助手页面 - Glassmorphism现代风格 */
page {
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 50%, #EDE9FE 100%);
}

/* 顶部导航栏 - Glassmorphism风格 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 50%, #A78BFA 100%);
  color: white;
  box-shadow: 0 10rpx 40rpx rgba(124, 58, 237, 0.3);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  border-radius: 0 0 30rpx 30rpx;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.clear-btn {
  padding: 12rpx 24rpx;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.clear-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.clear-text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 聊天区域 */
.chat-container {
  flex: 1;
  padding: 140rpx 30rpx 280rpx;
  overflow-y: auto;
}

/* 欢迎消息 - Glassmorphism卡片 */
.welcome-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 40rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  margin: 20rpx 0 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.4), 0 0 60rpx rgba(124, 58, 237, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  animation: float 3s ease-in-out infinite, welcomeGlow 2s ease-in-out infinite;
}

@keyframes welcomeGlow {
  0%, 100% {
    box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.4), 0 0 60rpx rgba(124, 58, 237, 0.3);
  }
  50% {
    box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.4), 0 0 100rpx rgba(124, 58, 237, 0.5);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4C1D95;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.welcome-list {
  text-align: left;
  margin-bottom: 30rpx;
  width: 100%;
}

.welcome-item {
  font-size: 26rpx;
  color: #4B5563;
  margin-bottom: 15rpx;
  padding: 15rpx 20rpx;
  background: rgba(124, 58, 237, 0.05);
  border-radius: 16rpx;
  border-left: 4rpx solid #7C3AED;
  transition: all 0.3s ease;
}

.welcome-item:active {
  background: rgba(124, 58, 237, 0.1);
  transform: translateX(10rpx);
}

.welcome-tip {
  font-size: 26rpx;
  color: #7C3AED;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  padding: 20rpx 30rpx;
  border-radius: 30rpx;
  font-weight: 600;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  animation: slideIn 0.4s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ai-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-avatar {
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  color: white;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  animation: aiGlow 2s ease-in-out infinite;
}

@keyframes aiGlow {
  0%, 100% {
    box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.3), 0 0 20rpx rgba(124, 58, 237, 0.2);
  }
  50% {
    box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.3), 0 0 40rpx rgba(124, 58, 237, 0.4);
  }
}

.user-avatar {
  background: linear-gradient(135deg, #06B6D4 0%, #22D3EE 100%);
  color: white;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.message-item:active .avatar {
  transform: scale(1.1);
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.message-bubble {
  padding: 25rpx 30rpx;
  border-radius: 24rpx;
  word-wrap: break-word;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.message-bubble:active {
  transform: scale(0.98);
}

.ai-bubble {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-top-left-radius: 8rpx;
  color: #1F2937;
}

.user-bubble {
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
  color: white;
  border-top-right-radius: 8rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.message-time {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 10rpx;
  text-align: right;
}

.user-message .message-time {
  color: rgba(255, 255, 255, 0.8);
}

/* 正在输入提示 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.typing-bubble {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  border-top-left-radius: 8rpx;
  padding: 25rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.typing-dots {
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 快捷问题区域 - Glassmorphism风格 */
.quick-questions {
  position: fixed;
  bottom: 140rpx;
  left: 0;
  right: 0;
  padding: 25rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.quick-scroll {
  white-space: nowrap;
}

.quick-list {
  display: flex;
  gap: 20rpx;
}

.quick-item {
  display: inline-block;
  padding: 18rpx 30rpx;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  color: #7C3AED;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(124, 58, 237, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.1);
}

.quick-item:active {
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
  color: white;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}

/* 输入区域 - Glassmorphism风格 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 25rpx 30rpx;
  padding-bottom: calc(25rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.input-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background: rgba(124, 58, 237, 0.08);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #1F2937;
  border: 2rpx solid rgba(124, 58, 237, 0.15);
  transition: all 0.3s ease;
}

.message-input:focus {
  outline: none;
  border-color: #7C3AED;
  background: rgba(124, 58, 237, 0.05);
  box-shadow: 0 0 0 4rpx rgba(124, 58, 237, 0.1);
}

.message-input::placeholder {
  color: #A78BFA;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.3);
}

.send-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.2);
}

.send-btn.disabled {
  background: #E5E7EB;
  box-shadow: none;
}

.send-icon {
  font-size: 32rpx;
  color: white;
  transform: rotate(-45deg);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: 40rpx 20rpx 25rpx;
  }

  .chat-container {
    padding: 120rpx 20rpx 260rpx;
  }

  .welcome-message {
    padding: 40rpx 30rpx;
  }

  .message-content {
    max-width: 75%;
  }

  .quick-questions {
    padding: 20rpx;
    bottom: 130rpx;
  }

  .input-area {
    padding: 20rpx;
  }
}
